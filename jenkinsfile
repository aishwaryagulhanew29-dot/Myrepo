pipeline {
    agent any
    stages {
        stage('pull'){
steps {
    git branch:'main', url:'https://github.com/aishwaryagulhanew29-dot/Myrepo.git'
}  
  }
        stage('build'){
steps {
    echo "build success"
}   
        }
        stage('test'){
steps {
    echo "test success"
}    

 }

        stage('deploy'){
steps {
    echo "deploy success"
}    
}
    }
}
